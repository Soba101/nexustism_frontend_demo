# Dependencies — reinstalled fresh inside the builder stage
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local build artifacts
.next
out

# Environment files — secrets must never enter the image
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Development tooling not needed in the image
.git
.gitignore
README.md
CLAUDE.md
docs/
vitest.config.ts

# Test files
src/test/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
